{
    "name": "@marceloclp/bsd",
    "version": "0.1.0",
    "description": "Type-safe, composable binary decoding for TypeScript.",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build:js": "bun build ./src/index.ts --outdir ./dist --entry-naming [name].js --target browser --format esm --sourcemap=external",
        "build:types": "tsc -p tsconfig.build.json",
        "build": "bun run clean && bun run build:js && bun run build:types",
        "verify:package": "bun run build && bun run ./scripts/package-smoke.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "prepack": "bun run build",
        "prepublishOnly": "bun run typecheck && bun test && bun run verify:package",
        "docs:dev": "bun --bun blume dev",
        "docs:build": "bun --bun blume build --isolated",
        "docs:check": "bun --bun blume check",
        "docs:validate": "bun --bun blume validate",
        "lint": "bun --bun oxlint -c oxlint.config.ts",
        "format": "bun --bun oxfmt -c oxfmt.config.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "blume": "^1.2.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2"
    }
}
